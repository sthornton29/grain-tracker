NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Anthropic API key — powers AI PDF parsing (settlements, scale tickets,
# brokerage statements) via /api/parse-document.
ANTHROPIC_API_KEY=YOUR-ANTHROPIC-KEY

# Barchart OnDemand API key — powers live futures/options pricing across the app:
# the Hedging price board (/api/market-prices, /api/options-prices), crop-insurance
# harvest-price estimates (/api/harvest-price-estimate), and ARC/PLC MYA estimates
# (/api/mya-estimate). Server-side only — never exposed to the browser. Without it,
# those features fall back to the most recent cached prices or manual entry.
BARCHART_API_KEY=YOUR-BARCHART-KEY

# USDA NASS Quick Stats API key — powers the monthly MYA price lookup
# (/api/nass-monthly-prices): published national "prices received by farmers"
# for every covered commodity, including the seed cotton lint + cottonseed
# blend. FREE — register at https://quickstats.nass.usda.gov/api. Server-side
# only. Without it, the panel's lookup reports "not configured" and offers the
# AI web-search fallback (which uses ANTHROPIC_API_KEY).
NASS_API_KEY=YOUR-NASS-KEY

# Read-only partner API (/api/partner/v1/*) — bearer token the intercompany
# engine authenticates with. Server-side only. Unset = every partner request
# 401s (fails closed). Generate a long random value (32+ bytes).
PARTNER_API_TOKEN=YOUR-PARTNER-TOKEN

# Supabase service-role key — the partner API reads with it (RLS grants only
# the authenticated role, and the partner API has no user session). Server-side
# only, NEVER exposed to the browser. From Supabase → Project Settings → API.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
