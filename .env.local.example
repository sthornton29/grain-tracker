NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Anthropic API key — powers AI PDF parsing (settlements, scale tickets,
# brokerage statements) via /api/parse-document.
ANTHROPIC_API_KEY=YOUR-ANTHROPIC-KEY

# Barchart OnDemand API key — powers end-of-day futures pricing on the Hedging
# page via /api/market-prices. Without it, the page falls back to cached prices.
BARCHART_API_KEY=YOUR-BARCHART-KEY
